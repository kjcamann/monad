ERR_DEF(MONAD_ABIERR_ILLEGAL_UINT,         "Illegal unsigned integer")
ERR_DEF(MONAD_ABIERR_ILLEGAL_STRING,       "Illegal character string")
ERR_DEF(MONAD_ABIERR_ILLEGAL_ABI_TYPE,     "ABI does not allow this type")
ERR_DEF(MONAD_ABIERR_OVERFLOW,             "Value too large for output datatype")
ERR_DEF(MONAD_ABIERR_ELEMENT_UNINIT,       "One or more tuple elements not initialized")
ERR_DEF(MONAD_ABIERR_NO_DYNAMIC,           "Function cannot accept dynamic tuple elements")
