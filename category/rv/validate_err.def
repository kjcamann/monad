ERR_DEF(MONAD_RV_VCODE_UNKNOWN,        "Unknown RV64 code validation error")
ERR_DEF(MONAD_RV_VCODE_NO_PREFIX,      "Code did start with 0xAE0001 prefix")
ERR_DEF(MONAD_RV_VCODE_BAD_HEADER,     "Malformed monad_rv_code_header")
ERR_DEF(MONAD_RV_VCODE_OVERFLOW,       "Code size exceeded MONAD_RV_CODE_MAX_SIZE")
ERR_DEF(MONAD_RV_VCODE_POINTS_OUTSIDE, "code_length points past code buffer end")
ERR_DEF(MONAD_RV_VCODE_INVALID_FORMAT, "Code is not in a recognized format -- no known magic number")
ERR_DEF(MONAD_RV_VCODE_LIBZSTD_ERR,    "libzstd error when trying to decompress code")
ERR_DEF(MONAD_RV_VCODE_HAS_ELF_MAGIC,  "Partially validated; ELF magic number detected")
ERR_DEF(MONAD_RV_VCODE_HAS_ZSTD_MAGIC, "Partially validated; ZSTD frame magic number detected")
ERR_DEF(MONAD_RV_VCODE_ELF_NOT_RV64,   "ELF image is not RV64 (wrong class or machine type)")
ERR_DEF(MONAD_RV_VCODE_NO_INIT_FN,     "init_contract function missing")
ERR_DEF(MONAD_RV_VCODE_NO_MAIN_FN,     "txn_main function missing")
ERR_DEF(MONAD_RV_VCODE_OK,             "No code validation error")
